{
  "name": "textoneitor",
  "version": "1.2.1",
  "description": "Revisor de textos en español: marca lo que suena a máquina (muletillas, rayas de inciso, tríadas, frases todas del mismo largo) y explica por qué. Determinista, sin IA y sin red.",
  "license": "BUSL-1.1",
  "author": "Josulo72 (https://github.com/Josulo72)",
  "homepage": "https://josulo72.github.io/textoneitor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Josulo72/textoneitor.git",
    "directory": "packages/linter"
  },
  "bugs": {
    "url": "https://github.com/Josulo72/textoneitor/issues"
  },
  "keywords": [
    "español",
    "spanish",
    "escritura",
    "estilo",
    "texto",
    "markdown",
    "revisor",
    "prose",
    "writing",
    "cli",
    "pre-commit",
    "claude-code"
  ],
  "type": "module",
  "main": "./dist/api/index.js",
  "types": "./dist/api/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./package.json": "./package.json",
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/engine.mjs"
    },
    "./rulepack.json": "./rulepack/rulepack.json"
  },
  "bin": {
    "textoneitor": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "rulepack",
    "rules/profiles",
    "rules/situaciones.yml",
    "schemas",
    "README.md",
    "LICENSE",
    "LICENSE-AGPL-3.0"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:rules && pnpm run build:bundle && pnpm run build:web",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:rules": "node dist/rules/compiler/build.js",
    "build:bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "node scripts/bundle-web.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "commander": "^13.0.0",
    "fast-glob": "^3.3.0",
    "ignore": "^7.0.0",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-frontmatter": "^2.0.0",
    "mdast-util-gfm": "^3.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.0"
  }
}
